# Скопируйте в .env и поправьте под себя:  cp .env.example .env

# --- Airflow ---------------------------------------------------------------
# UID пользователя хоста (выводится командой `id -u`). Если оставить дефолт
# 50000 на Linux, файлы в ./logs и ./config создадутся от чужого uid.
AIRFLOW_UID=1000

# Логин/пароль веб-интерфейса http://localhost:8080 (создаёт сервис airflow-init).
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- Витрина CityBikes (сервис citybikes-db) -------------------------------
# Именно в эту БД пишет DAG через коннект postgres_default.
# База метаданных Airflow (сервис postgres) — отдельная, airflow/airflow.
POSTGRES_DB=citybikes
POSTGRES_USER=citybikes
POSTGRES_PASSWORD=citybikes

# Порт витрины на хосте.
POSTGRES_HOST_PORT=5433